generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------completed part start-------------------------
model User {
  id               String         @id @default(uuid())
  email            String         @unique
  index            Int            @unique @default(autoincrement())
  passwordHash     String?        // null for social auth users
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  userType         String
  evanAddress      String         @default("")
  // Social auth fields
  googleId         String?        @unique
  appleId          String?        @unique
  authProvider     String         @default("local") // "local" | "google" | "apple"
  displayName      String?
  avatarUrl        String?
  buyer            Buyer?
  receivedMessages Message[]      @relation("ReceivedMessages")
  sentMessages     Message[]      @relation("SentMessages")
  notifications    Notification[]
  vendor           Vendor?
  refreshTokens    RefreshToken[]
  fcmTokens        FcmToken[]

  @@map("user")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Buyer {
  id     String @id @default(uuid())
  userId String @unique

  fullName          String
  phone             String
  nidNumber         String
  nidFontPhotoUrl   String // document
  nidBackPhotoUrl   String // document
  profilePhotoUrl   String // document
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  gender            String
  country           String
  isNidVerify       Boolean                 @default(false)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cart              Cart?
  couponAssignments CouponBuyerAssignment[]
  messages          Message[]
  conversations     Conversation[]
  adminChatThread   AdminChatThread?
  adminChatMessages AdminChatMessage[]      @relation("AdminChatBuyerMessages")
  orders            Order[]
  connections       VendorBuyerConnection[]
  productReviews    ProductReview[]
  vendorReviews     VendorReview[]
}

model Vendor {
  id                    String  @id @default(uuid())
  userId                String  @unique
  vendorCode            String  @unique @default(dbgenerated("'VEN-' || UPPER(SUBSTRING(MD5(RANDOM()::TEXT) FROM 1 FOR 8))"))
  fullName              String
  phone                 String
  address               String
  storename             String
  storeDescription      String
  gender                String
  businessName          String?
  businessDescription   String?
  logoUrl               String
  nationalIdNumber      String
  nidFontPhotoUrl       String //document
  nidBackPhotoUrl       String //document
  bussinessIdPhotoUrl   String //document 
  country               String
  isNidVerify           Boolean @default(false)
  bussinessRegNumber    String
  isBussinessIdVerified Boolean @default(false)
  website               String  @default("")
  stripeAccountId       String?
  stripeAccountStatus   String? // pending | verified | restricted
  stripeChargesEnabled  Boolean @default(false)
  stripePayoutsEnabled  Boolean @default(false)

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  averageRating Float?   @default(0)
  totalReviews  Int      @default(0)

  categories        Category[]
  coupons           Coupon[]
  messages          Message[]
  conversations     Conversation[]
  adminChatThread   AdminChatThread?
  adminChatMessages AdminChatMessage[]      @relation("AdminChatVendorMessages")
  orders            Order[]
  products          Product[]
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  connections       VendorBuyerConnection[]
  vendorReviews     VendorReview[]
}

model Category {
  id           String    @id @default(uuid())
  vendorId     String
  name         String
  thumbnail    String
  description  String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  vendor       Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([vendorId])
}

model Product {
  id              String          @id @default(uuid())
  vendorId        String
  categoryId      String
  name            String
  description     String?
  price           Decimal         @db.Decimal(10, 2)
  stockQuantity   Int             @default(0)
  imageUrl        String?
  isAvailable     Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  images          String[]
  sku             String          @unique
  minimulAuantity Int
  cartItems       CartItem[]
  orderItems      OrderItem[]
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendor          Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  specifications  Specification[]
  productReviews  ProductReview[]
  averageRating   Float?          @default(0)
  totalReviews    Int             @default(0)

  @@index([vendorId])
  @@index([categoryId])
}

model Specification {
  id        String  @id @default(uuid())
  productId String
  label     String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([email, otp])
  @@map("password_reset_otp")
}

// ------------------------------completed part End-------------------------
model VendorBuyerConnection {
  id          String   @id @default(uuid())
  vendorId    String
  buyerId     String
  isActive    Boolean  @default(true)
  connectedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  buyer       Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, buyerId])
  @@index([buyerId])
  @@index([vendorId])
}

model Cart {
  id        String     @id @default(uuid())
  buyerId   String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  buyer     Buyer      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id              String   @id @default(uuid())
  cartId          String
  productId       String
  quantity        Int
  priceAtAddition Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
}

model Order {
  id              String          @id @default(uuid())
  buyerId         String
  vendorId        String
  orderNumber     String          @unique @default(dbgenerated("'ORD-' || upper(substr(md5(random()::text), 1, 4))"))
  subtotal        Decimal         @db.Decimal(10, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal         @db.Decimal(10, 2)
  shippingAddress String?
  couponId        String?
  customerNote    String?
  termsAccepted   Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  status          String
  optionalAddress String
  country         String
  buyer           Buyer           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  coupon          Coupon?         @relation(fields: [couponId], references: [id])
  vendor          Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  messages        Message[]
  payments        Payment?
  productReviews  ProductReview[]
  vendorReviews   VendorReview[]

  @@index([buyerId])
  @@index([vendorId])
  @@index([orderNumber])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id                    String   @id @default(uuid())
  orderId               String   @unique
  stripePaymentId       String?  @unique // This is the session ID
  stripeCustomerId      String?
  amount                Decimal  @db.Decimal(10, 2)
  adminCommissionAmount Decimal  @default(0) @db.Decimal(10, 2)
  vendorPayoutAmount    Decimal  @default(0) @db.Decimal(10, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  status                String

  // NEW: Add these fields for better tracking
  paymentMethod  String? // e.g., "card", "wallet"
  lastFourDigits String? // Last 4 digits of card (safe to store)
  cardBrand      String? // e.g., "visa", "mastercard"
  expiresAt      DateTime? // When the checkout session expires

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([stripePaymentId])
}

model Coupon {
  id                String                  @id @default(uuid())
  vendorId          String
  code              String?                 @unique @default(dbgenerated("upper(substr(md5(random()::text), 1, 6))"))
  discountValue     Decimal                 @db.Decimal(10, 2)
  minPurchaseAmount Decimal?                @db.Decimal(10, 2)
  maxDiscountAmount Decimal?                @db.Decimal(10, 2)
  validFrom         DateTime                @default(now())
  validUntil        DateTime
  usageLimit        Int?                    @default(1)
  usedCount         Int                     @default(0)
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  discountType      String
  vendor            Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  buyerAssignments  CouponBuyerAssignment[]
  orders            Order[]
  name              String                  @default("")

  @@unique([vendorId, code])
  @@index([vendorId])
}

model CouponBuyerAssignment {
  id        String    @id @default(uuid())
  couponId  String
  buyerId   String
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  buyer     Buyer     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  coupon    Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, buyerId])
  @@index([buyerId])
}

model Conversation {
  id              String   @id @default(uuid())
  vendorId        String
  buyerId         String
  pinnedMessageId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  buyer           Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  messages        Message[] @relation("ConversationMessages")
  pinnedMessage   Message?  @relation("PinnedConversationMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)

  @@unique([vendorId, buyerId])
  @@index([buyerId])
  @@index([vendorId])
}

model Message {
  id                   String        @id @default(uuid())
  senderId             String
  receiverId           String
  vendorId             String?
  buyerId              String?
  orderId              String?
  conversationId       String?
  messageText          String
  type                 String        @default("TEXT")
  metadata             Json?
  isRead               Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  buyer                Buyer?        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  conversation         Conversation? @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: SetNull)
  order                Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  receiver             User          @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender               User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  vendor               Vendor?       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  pinnedInConversation Conversation? @relation("PinnedConversationMessage")

  @@index([senderId])
  @@index([receiverId])
  @@index([vendorId, buyerId])
  @@index([conversationId])
  @@index([orderId])
  @@index([type])
}

model Notification {
  id          String               @id @default(uuid())
  userId      String
  title       String
  message     String
  type        NotificationType     @default(info)
  category    NotificationCategory @default(system)
  broadcastId String?
  isRead      Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([userId])
  @@index([broadcastId])
}

model FcmToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NotificationType {
  info
  success
  warning
  error
}

enum NotificationCategory {
  system
  buyer
  vendor
  broadcast
}

enum AdminRole {
  SUPER_ADMIN
  EMPLOYEE
}

model Admin {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  passwordHash      String
  bio               String             @default("")
  fullName          String             @default("N/A")
  avatar            String             @default("https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?ixlib=rb-1.2.1&auto=format&fit=facearea&facepad=2&w=256&h=256&q=80")
  role              AdminRole
  permissions       AdminPermission[]
  adminChatThreads  AdminChatThread[]  @relation("AdminChatAssignedAdmin")
  adminChatMessages AdminChatMessage[] @relation("AdminChatAdminMessages")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Permission {
  id          Int               @id @default(autoincrement())
  key         String            @unique // e.g. "dashboard.view"
  name        String
  description String?
  admins      AdminPermission[]
}

model AdminPermission {
  adminId      Int
  permissionId Int

  admin      Admin      @relation(fields: [adminId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([adminId, permissionId])
}

// Review Models
model ProductReview {
  id                 String   @id @default(uuid())
  productId          String
  buyerId            String
  orderId            String? // Optional: Link to order for verified purchases
  rating             Int // 1-5 stars
  comment            String?
  isVerifiedPurchase Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   Buyer   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([productId, buyerId, orderId]) // One review per product per order
  @@index([productId])
  @@index([buyerId])
  @@index([rating])
  @@map("product_review")
}

model VendorReview {
  id                 String   @id @default(uuid())
  vendorId           String
  buyerId            String
  orderId            String? // Optional: Link to order for verified reviews
  rating             Int // 1-5 stars
  comment            String?
  isVerifiedPurchase Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  buyer  Buyer  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([vendorId, buyerId, orderId]) // One review per vendor per order
  @@index([vendorId])
  @@index([buyerId])
  @@index([rating])
  @@map("vendor_review")
}

enum ActivityType {
  ORDER_CREATED
  ORDER_DELIVERED
  ORDER_CREATE_FAILED
  VENDOR_KYC_SUBMITTED
  USER_REGISTERED
  PAYMENT_RECEIVED
}

enum AdminChatSenderType {
  ADMIN
  BUYER
  VENDOR
}

model AdminChatThread {
  id              String   @id @default(uuid())
  buyerId         String?
  vendorId        String?
  assignedAdminId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  buyer         Buyer?             @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  vendor        Vendor?            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  assignedAdmin Admin?             @relation("AdminChatAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages      AdminChatMessage[]

  @@unique([buyerId])
  @@unique([vendorId])
  @@index([buyerId])
  @@index([vendorId])
  @@index([assignedAdminId])
}

model AdminChatMessage {
  id             String   @id @default(uuid())
  threadId       String
  senderType     String
  senderAdminId  Int?
  senderBuyerId  String?
  senderVendorId String?
  messageText    String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  thread       AdminChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderAdmin  Admin?          @relation("AdminChatAdminMessages", fields: [senderAdminId], references: [id], onDelete: Cascade)
  senderBuyer  Buyer?          @relation("AdminChatBuyerMessages", fields: [senderBuyerId], references: [id], onDelete: Cascade)
  senderVendor Vendor?         @relation("AdminChatVendorMessages", fields: [senderVendorId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderType])
  @@index([createdAt])
}

enum ActorType {
  USER
  VENDOR
  ADMIN
  SYSTEM
}

model ActivityLog {
  id String @id @default(uuid())

  type        ActivityType
  title       String
  description String

  entity   String?
  entityId String?

  actorType ActorType?
  actorName String?

  meta Json?

  createdAt DateTime @default(now())
}
